.env
.env.local
*.env.local
google-service-account.json
service-account*.json

__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

.venv/
venv/
env/

.DS_Store
.idea/
.vscode/

*.log
tmp/
.tmp/

# Generated artifacts — keep the dirs (via .gitkeep) but ignore contents on main.
# Phase 3: state/ contents are persisted on the `state` branch via the workflow.
# Phase 3: out/ artifacts are uploaded as GHA artifacts per-run.
state/*
!state/.gitkeep
out/*
!out/.gitkeep
.claude/
antariksh/paras_videos.json

# JS/app build artifacts & caches (listing-studio*, studd-muffyn-app)
node_modules/
.expo/
.next/
dist/
build/
.turbo/
*.tsbuildinfo
.vercel/
listing-studio/worker_jobs/
sheet-archives/

# astro-bot: customer PII (names, DOB, phone numbers) — never committed
astro-bot/*.db
astro-bot/*.db-shm
astro-bot/*.db-wal
astro-bot/backups/
# ...and secrets. This repo is PUBLIC: the plain `.env` rule above does not
# match `.env.bak.<stamp>`, which holds a live WA_ACCESS_TOKEN.
astro-bot/.env.bak*
astro-bot/.whatsapp_2fa_pin
astro-bot/.tunnel_url
# Runtime output — server.out and the logs carry customer messages and charts.
astro-bot/server.out
astro-bot/*.log
