{%- liquid
  assign p = product
  assign v = p.selected_or_first_available_variant
  assign wa = section.settings.whatsapp_url
-%}

{%- if section.settings.hide_theme_chrome -%}
  {%- comment -%}
    Standalone landing page: hide the theme's header and footer groups.
    This CSS only ships on templates that render this section, so it can't
    leak onto the rest of the store. The overlay group is left alone so the
    cart drawer still works when someone buys.
  {%- endcomment -%}
  <style>
    .shopify-section-group-header-group,
    .shopify-section-group-footer-group { display: none !important; }
    body { padding-top: 0 !important; }
  </style>
{%- endif -%}

{% style %}
  .dst-{{ section.id }} {
    --gold: {{ section.settings.gold }};
    --violet: {{ section.settings.violet }};
    --ink: #ffffff;
    --muted: rgba(255,255,255,.72);
    --card: rgba(255,255,255,.045);
    --line: rgba(255,255,255,.12);
    background:
      radial-gradient(900px 500px at 80% 8%, rgba(139,92,246,.30), transparent 60%),
      radial-gradient(700px 420px at 10% 40%, rgba(217,119,6,.16), transparent 60%),
      linear-gradient(180deg, #0a0713 0%, #120a24 45%, #0a0713 100%);
    color: var(--ink);
    font-family: {{ section.settings.body_font }};
    overflow: hidden;
  }
  .dst-{{ section.id }} * { box-sizing: border-box; }
  .dst-{{ section.id }} a { color: inherit; }
  .dst-{{ section.id }} .wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
  .dst-{{ section.id }} .serif { font-family: {{ section.settings.display_font }}; }

  /* ---------- sticky page header (replaces the theme header) ---------- */
  .dsthead-{{ section.id }} {
    position:sticky; top:0; z-index:60;
    background:{{ section.settings.topbar_bg }};
    font-family:{{ section.settings.body_font }};
  }
  .dsthead-{{ section.id }} .row {
    max-width:1120px; margin:0 auto; padding:12px 20px;
    display:flex; align-items:center; gap:16px;
  }
  .dsthead-{{ section.id }} .brand { display:flex; align-items:center; gap:14px; min-width:0; }
  .dsthead-{{ section.id }} .mark {
    width:52px; height:52px; border-radius:12px; flex:none;
    background:{{ section.settings.topbar_mark_bg }};
    display:grid; place-items:center; overflow:hidden;
  }
  .dsthead-{{ section.id }} .mark { width:74px; height:52px; border-radius:12px; }
  .dsthead-{{ section.id }} .mark img { width:100%; height:100%; object-fit:contain; padding:6px 8px; }
  .dsthead-{{ section.id }} .mark span { font-size:9px; font-weight:800; letter-spacing:.06em; color:#111; text-align:center; line-height:1.1; }
  .dsthead-{{ section.id }} .t { min-width:0; }
  .dsthead-{{ section.id }} .t b { display:block; font-size:clamp(14px,1.5vw,19px); font-weight:700; color:{{ section.settings.topbar_ink }}; line-height:1.25; }
  .dsthead-{{ section.id }} .t small { display:block; font-size:clamp(11.5px,1.15vw,14px); color:{{ section.settings.topbar_sub_ink }}; margin-top:3px; }
  .dsthead-{{ section.id }} .buy { margin-left:auto; display:flex; align-items:center; gap:16px; flex:none; }
  .dsthead-{{ section.id }} .buy .amt { font-size:clamp(16px,1.9vw,22px); font-weight:800; color:{{ section.settings.topbar_ink }}; }
  .dsthead-{{ section.id }} .buy .btn {
    border:0; cursor:pointer; font:inherit; font-weight:700;
    font-size:clamp(13px,1.4vw,16px); color:{{ section.settings.topbar_btn_ink }};
    background:{{ section.settings.topbar_btn_bg }};
    padding:13px 30px; border-radius:12px; text-decoration:none;
    transition:filter .18s, transform .15s; white-space:nowrap;
  }
  .dsthead-{{ section.id }} .buy .btn:hover { filter:brightness(1.06); transform:translateY(-1px); }
  .dsthead-{{ section.id }} .note {
    background:{{ section.settings.note_bg }}; color:{{ section.settings.note_ink }};
    text-align:center; font-size:clamp(11.5px,1.2vw,14.5px); padding:11px 16px; line-height:1.4;
  }
  @media (max-width:760px) {
    .dsthead-{{ section.id }} .row { padding:10px 14px; gap:11px; }
    .dsthead-{{ section.id }} .mark { width:60px; height:42px; border-radius:10px; }
    .dsthead-{{ section.id }} .t small { display:none; }
    .dsthead-{{ section.id }} .buy { gap:10px; }
    .dsthead-{{ section.id }} .buy .btn { padding:11px 18px; }
    .dsthead-{{ section.id }} .note { padding:9px 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .dsthead-{{ section.id }} .buy .btn { transition:none; } }

  /* ---------- top bar ---------- */
  .dst-{{ section.id }} .top { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:26px 0 8px; flex-wrap:wrap; }
  .dst-{{ section.id }} .logo { line-height:1; }
  .dst-{{ section.id }} .logo b { font-family:{{ section.settings.display_font }}; font-size:clamp(30px,3.6vw,44px); font-weight:600; letter-spacing:.01em; }
  .dst-{{ section.id }} .logo span { display:block; font-size:10px; letter-spacing:.34em; color:var(--muted); margin-top:4px; }
  .dst-{{ section.id }} .pills { display:flex; gap:10px; flex-wrap:wrap; }
  .dst-{{ section.id }} .pill { display:inline-flex; align-items:center; gap:7px; border:1px solid var(--line); border-radius:999px; padding:8px 14px; font-size:12.5px; color:var(--muted); background:rgba(255,255,255,.03); }
  .dst-{{ section.id }} .pill svg { width:14px; height:14px; color:var(--gold); flex:none; }

  /* ---------- hero ---------- */
  .dst-{{ section.id }} .hero { display:grid; grid-template-columns:1.02fr .98fr; gap:36px; align-items:center; padding:22px 0 54px; }
  .dst-{{ section.id }} .eyebrow { font-size:12px; letter-spacing:.22em; color:var(--gold); font-weight:700; margin:0 0 14px; }
  .dst-{{ section.id }} h1 { font-family:{{ section.settings.display_font }}; font-weight:600; font-size:clamp(32px,4.6vw,54px); line-height:1.1; margin:0 0 18px; }
  .dst-{{ section.id }} h1 .g { color:var(--gold); }
  .dst-{{ section.id }} h1 .v { color:#c4a2ff; }
  .dst-{{ section.id }} .hero-buy {
    display:flex; align-items:center; gap:18px; flex-wrap:wrap;
    margin:0 0 22px; padding:16px 18px;
    border:1px solid rgba(212,175,55,.38); border-radius:14px;
    background:linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.02));
    max-width:520px;
  }
  .dst-{{ section.id }} .hero-buy .p b { font-size:clamp(27px,3.2vw,36px); font-weight:800; line-height:1; display:block; }
  .dst-{{ section.id }} .hero-buy .p s { font-size:14px; color:var(--muted); font-weight:400; margin-right:8px; }
  .dst-{{ section.id }} .hero-buy .p small { display:block; font-size:11.5px; color:var(--muted); margin-top:5px; }
  .dst-{{ section.id }} .hero-buy .cta { width:auto; flex:1; min-width:170px; padding:14px 20px; font-size:15.5px; }
  .dst-{{ section.id }} .lede { color:var(--muted); font-size:clamp(14px,1.25vw,16px); line-height:1.65; margin:0 0 14px; max-width:52ch; }
  .dst-{{ section.id }} .feat { display:flex; gap:0; border:1px solid var(--line); border-radius:14px; overflow:hidden; margin:22px 0 24px; background:rgba(255,255,255,.03); max-width:520px; }
  .dst-{{ section.id }} .feat div { flex:1; padding:12px 14px; font-size:12.5px; line-height:1.35; display:flex; gap:9px; align-items:center; }
  .dst-{{ section.id }} .feat div + div { border-left:1px solid var(--line); }
  .dst-{{ section.id }} .feat svg { width:17px; height:17px; color:var(--gold); flex:none; }
  .dst-{{ section.id }} .social { display:flex; align-items:center; gap:14px; flex-wrap:wrap; }
  .dst-{{ section.id }} .avatars { display:flex; }
  .dst-{{ section.id }} .avatars i,
  .dst-{{ section.id }} .avatars img {
    width:34px; height:34px; border-radius:50%; border:2px solid #150c28;
    margin-left:-10px; display:block; object-fit:cover; background:#2a1b45;
  }
  .dst-{{ section.id }} .avatars i {
    background:linear-gradient(135deg,#f0b27a,#c46b9b);
    position:relative; overflow:hidden;
  }
  /* fallback silhouette so empty slots read as people, not blobs */
  .dst-{{ section.id }} .avatars i::before {
    content:""; position:absolute; left:50%; top:22%; width:34%; aspect-ratio:1;
    transform:translateX(-50%); border-radius:50%; background:rgba(255,255,255,.62);
  }
  .dst-{{ section.id }} .avatars i::after {
    content:""; position:absolute; left:50%; bottom:-14%; width:66%; aspect-ratio:1;
    transform:translateX(-50%); border-radius:50%; background:rgba(255,255,255,.62);
  }
  .dst-{{ section.id }} .avatars i:first-child { margin-left:0; }
  .dst-{{ section.id }} .stars { color:var(--gold); letter-spacing:2px; font-size:15px; }
  .dst-{{ section.id }} .count b { display:block; font-size:16px; }
  .dst-{{ section.id }} .count span { font-size:12.5px; color:var(--muted); }

  /* ---------- hero backdrop (real artwork if supplied, else SVG) ---------- */
  .dst-{{ section.id }} .stagewrap { position:relative; display:flex; justify-content:center; align-items:center; }
  .dst-{{ section.id }} .heroart {
    display:block; width:100%; height:auto; max-width:520px;
    border-radius:18px;
    -webkit-mask-image: radial-gradient(120% 100% at 50% 45%, #000 62%, transparent 100%);
            mask-image: radial-gradient(120% 100% at 50% 45%, #000 62%, transparent 100%);
  }
  .dst-{{ section.id }} .bgart {
    position:absolute; inset:-26% -22%; z-index:0; pointer-events:none;
    background-position:center; background-repeat:no-repeat; background-size:contain;
    opacity:{{ section.settings.bg_opacity | divided_by: 100.0 }};
  }
  .dst-{{ section.id }} .bgart svg { width:100%; height:100%; display:block; }
  .dst-{{ section.id }} .stagewrap .phone { position:relative; z-index:1; }
  .dst-{{ section.id }} .zodiac { animation: dst-spin-{{ section.id }} 150s linear infinite; transform-origin:310px 310px; }
  .dst-{{ section.id }} .galaxy { animation: dst-drift-{{ section.id }} 26s ease-in-out infinite alternate; transform-origin:50% 50%; }
  @keyframes dst-spin-{{ section.id }} { to { transform: rotate(360deg); } }
  @keyframes dst-drift-{{ section.id }} { from { transform: scale(1); opacity:.9 } to { transform: scale(1.06); opacity:1 } }
  @media (prefers-reduced-motion: reduce) {
    .dst-{{ section.id }} .zodiac, .dst-{{ section.id }} .galaxy { animation:none; }
  }

  /* ---------- phone ---------- */
  .dst-{{ section.id }} .phone { justify-self:center; width:min(330px,100%); border-radius:38px; border:9px solid #1c1830; background:#0d0a18; box-shadow:0 30px 90px rgba(88,28,135,.45); overflow:hidden; }
  .dst-{{ section.id }} .phone-top { display:flex; align-items:center; gap:9px; padding:12px 13px; background:#141024; border-bottom:1px solid var(--line); }
  .dst-{{ section.id }} .phone-top .av { width:30px; height:30px; border-radius:50%; background:var(--gold); color:#241500; font-weight:800; font-size:11px; display:grid; place-items:center; flex:none; }
  .dst-{{ section.id }} .phone-top b { font-size:13px; display:block; }
  .dst-{{ section.id }} .phone-top small { font-size:10.5px; color:#7ee08a; }
  .dst-{{ section.id }} .chat { padding:14px 12px 18px; background:#0f0b1c; display:flex; flex-direction:column; gap:10px; }
  .dst-{{ section.id }} .msg { max-width:86%; padding:10px 12px; border-radius:12px; font-size:12.5px; line-height:1.5; }
  .dst-{{ section.id }} .msg.me { align-self:flex-end; background:#dcf8c6; color:#0d2b12; border-bottom-right-radius:4px; }
  .dst-{{ section.id }} .msg.bot { align-self:flex-start; background:#f6f3ec; color:#1a1a1a; border-bottom-left-radius:4px; }
  .dst-{{ section.id }} .msg time { display:block; font-size:9.5px; opacity:.55; margin-top:5px; text-align:right; }

  /* ---------- stats ---------- */
  .dst-{{ section.id }} .stats { display:grid; grid-template-columns:repeat(4,1fr); border:1px solid var(--line); border-radius:16px; background:var(--card); overflow:hidden; }
  .dst-{{ section.id }} .stats div { padding:24px 16px; text-align:center; }
  .dst-{{ section.id }} .stats div + div { border-left:1px solid var(--line); }
  .dst-{{ section.id }} .stats svg { width:30px; height:30px; color:var(--gold); margin-bottom:10px; }
  .dst-{{ section.id }} .stats b { display:block; font-size:clamp(17px,2vw,23px); font-weight:700; }
  .dst-{{ section.id }} .stats span { font-size:12.5px; color:var(--muted); }

  /* ---------- section heads ---------- */
  .dst-{{ section.id }} .head { text-align:center; margin:64px 0 8px; }
  .dst-{{ section.id }} .head h2 { font-family:{{ section.settings.display_font }}; font-size:clamp(23px,2.8vw,32px); font-weight:600; margin:0; }
  .dst-{{ section.id }} .head h2::before, .dst-{{ section.id }} .head h2::after { content:"✦"; color:var(--gold); font-size:.6em; margin:0 14px; vertical-align:middle; }
  .dst-{{ section.id }} .head p { color:var(--muted); font-size:13.5px; margin:8px 0 26px; }

  /* ---------- chat examples ---------- */
  .dst-{{ section.id }} .cards3 { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
  .dst-{{ section.id }} .cc { border:1px solid var(--line); border-radius:14px; overflow:hidden; background:var(--card); }
  .dst-{{ section.id }} .cc .hd { display:flex; align-items:center; gap:9px; padding:11px 12px; background:rgba(255,255,255,.05); border-bottom:1px solid var(--line); }
  .dst-{{ section.id }} .cc .bd { padding:12px; display:flex; flex-direction:column; gap:9px; background:#0f0b1c; }

  /* ---------- steps ---------- */
  .dst-{{ section.id }} .steps { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
  .dst-{{ section.id }} .step { border:1px solid var(--line); border-radius:14px; background:var(--card); padding:20px; display:flex; gap:14px; }
  .dst-{{ section.id }} .step .n { width:34px; height:34px; border-radius:50%; background:var(--gold); color:#241500; font-weight:800; display:grid; place-items:center; flex:none; }
  .dst-{{ section.id }} .step b { display:block; margin-bottom:6px; font-size:14.5px; }
  .dst-{{ section.id }} .step p { margin:0; color:var(--muted); font-size:13px; line-height:1.6; }

  /* ---------- offer ---------- */
  .dst-{{ section.id }} .offer { display:grid; grid-template-columns:1fr 1.05fr; gap:34px; align-items:center; margin-top:56px; }
  .dst-{{ section.id }} .offer h3 { font-family:{{ section.settings.display_font }}; font-size:clamp(21px,2.4vw,28px); color:var(--gold); font-weight:600; margin:0 0 14px; }
  .dst-{{ section.id }} .offer p { color:var(--muted); font-size:13.5px; line-height:1.75; margin:0; }
  .dst-{{ section.id }} .price-card { position:relative; border:1px solid rgba(212,175,55,.45); border-radius:18px; padding:26px; background:linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.02)); }
  .dst-{{ section.id }} .badge { position:absolute; top:-11px; left:22px; background:var(--gold); color:#241500; font-size:10.5px; font-weight:800; letter-spacing:.08em; padding:5px 11px; border-radius:5px; }
  .dst-{{ section.id }} .amt { font-size:clamp(34px,4.4vw,46px); font-weight:800; line-height:1; }
  .dst-{{ section.id }} .amt small { font-size:13px; font-weight:400; color:var(--muted); margin-left:9px; }
  .dst-{{ section.id }} .ticks { list-style:none; padding:0; margin:18px 0 22px; display:flex; flex-direction:column; gap:11px; }
  .dst-{{ section.id }} .ticks li { display:flex; gap:10px; font-size:13.5px; line-height:1.5; color:var(--muted); }
  .dst-{{ section.id }} .ticks svg { width:17px; height:17px; color:var(--gold); flex:none; margin-top:1px; }
  .dst-{{ section.id }} .ticks b { color:var(--ink); font-weight:600; }
  .dst-{{ section.id }} .cta { display:flex; align-items:center; justify-content:center; gap:11px; width:100%; border:0; cursor:pointer;
    background:linear-gradient(180deg,#e8c063,#c9992f); color:#241500; font:inherit; font-weight:800; font-size:16px;
    padding:15px 20px; border-radius:11px; text-decoration:none; transition:filter .2s, transform .15s; }
  .dst-{{ section.id }} .cta svg { width:20px; height:20px; flex:none; }
  .dst-{{ section.id }} .wa svg { width:17px; height:17px; flex:none; }
  .dst-{{ section.id }} .pill svg, .dst-{{ section.id }} .feat svg,
  .dst-{{ section.id }} .ticks svg, .dst-{{ section.id }} .trust svg { flex:none; }
  .dst-{{ section.id }} .cc .hd svg { width:16px; height:16px; }
  .dst-{{ section.id }} .cta:hover { filter:brightness(1.07); transform:translateY(-1px); }
  .dst-{{ section.id }} .cta[disabled] { opacity:.7; cursor:default; }

  /* ---------- trust + footer ---------- */
  .dst-{{ section.id }} .trust { display:grid; grid-template-columns:repeat(3,1fr) auto; gap:22px; align-items:center; border-top:1px solid var(--line); margin-top:56px; padding:26px 0; }
  .dst-{{ section.id }} .trust .t { display:flex; gap:11px; align-items:flex-start; }
  .dst-{{ section.id }} .trust svg { width:22px; height:22px; color:var(--gold); flex:none; }
  .dst-{{ section.id }} .trust b { display:block; font-size:13.5px; }
  .dst-{{ section.id }} .trust span { font-size:12.5px; color:var(--muted); }
  .dst-{{ section.id }} .wa { display:inline-flex; align-items:center; gap:8px; background:#25d366; color:#07240f; font-weight:700; font-size:13.5px; padding:10px 16px; border-radius:8px; text-decoration:none; }
  .dst-{{ section.id }} .foot { border-top:1px solid var(--line); padding:30px 0 34px; display:grid; grid-template-columns:1.2fr repeat(3,1fr) 1fr; gap:24px; }
  .dst-{{ section.id }} .foot h4 { font-size:11px; letter-spacing:.16em; color:var(--muted); margin:0 0 12px; font-weight:700; }
  .dst-{{ section.id }} .foot ul { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:8px; }
  .dst-{{ section.id }} .foot a { font-size:13px; color:var(--muted); text-decoration:none; }
  .dst-{{ section.id }} .foot a:hover { color:var(--ink); }
  .dst-{{ section.id }} .pay { display:flex; gap:7px; flex-wrap:wrap; }
  .dst-{{ section.id }} .pay span { border:1px solid var(--line); border-radius:5px; padding:5px 9px; font-size:10.5px; color:var(--muted); background:rgba(255,255,255,.04); }
  .dst-{{ section.id }} .copy { text-align:center; color:rgba(255,255,255,.45); font-size:11.5px; padding-bottom:26px; }

  {%- if section.settings.mobile_mode == 'responsive' -%}
  @media (max-width: 1000px) {
    .dst-{{ section.id }} .hero { grid-template-columns:1fr; gap:30px; padding:14px 0 44px; text-align:center; }
    .dst-{{ section.id }} .lede { margin-left:auto; margin-right:auto; }
    .dst-{{ section.id }} .feat { margin-left:auto; margin-right:auto; }
    .dst-{{ section.id }} .hero-buy { margin-left:auto; margin-right:auto; justify-content:center; text-align:center; }
    .dst-{{ section.id }} .hero-buy .p { width:100%; }
    .dst-{{ section.id }} .social { justify-content:center; }
    .dst-{{ section.id }} .phone { order:-1; width:min(300px,86%); }
    .dst-{{ section.id }} .offer { grid-template-columns:1fr; gap:26px; }
    .dst-{{ section.id }} .steps { grid-template-columns:1fr; }
  }
  @media (max-width: 760px) {
    .dst-{{ section.id }} .wrap { padding:0 16px; }
    .dst-{{ section.id }} .top { justify-content:center; text-align:center; gap:14px; padding:22px 0 4px; }
    .dst-{{ section.id }} .pills { justify-content:center; }
    .dst-{{ section.id }} .pill { font-size:11.5px; padding:7px 11px; }

    /* stats: 2x2 with clean dividers */
    .dst-{{ section.id }} .stats { grid-template-columns:1fr 1fr; }
    .dst-{{ section.id }} .stats div { padding:18px 12px; border-left:0 !important; border-top:0; }
    .dst-{{ section.id }} .stats div:nth-child(even) { border-left:1px solid var(--line) !important; }
    .dst-{{ section.id }} .stats div:nth-child(n+3) { border-top:1px solid var(--line); }

    /* chat examples become a swipeable carousel that peeks the next card */
    .dst-{{ section.id }} .cards3 {
      grid-template-columns:none; display:flex; gap:12px;
      overflow-x:auto; scroll-snap-type:x mandatory;
      margin:0 -16px; padding:2px 16px 10px;
      -webkit-overflow-scrolling:touch; scrollbar-width:none;
    }
    .dst-{{ section.id }} .cards3::-webkit-scrollbar { display:none; }
    .dst-{{ section.id }} .cc { flex:0 0 86%; scroll-snap-align:center; }

    .dst-{{ section.id }} .head { margin:46px 0 6px; }
    .dst-{{ section.id }} .head h2::before, .dst-{{ section.id }} .head h2::after { margin:0 9px; }
    .dst-{{ section.id }} .step { padding:16px; }
    .dst-{{ section.id }} .price-card { padding:22px 18px; }
    .dst-{{ section.id }} .cta { padding:16px 18px; font-size:16.5px; }

    .dst-{{ section.id }} .trust { grid-template-columns:1fr; gap:16px; padding:22px 0; text-align:left; }
    .dst-{{ section.id }} .foot { grid-template-columns:1fr 1fr; gap:22px 18px; }
    .dst-{{ section.id }} .foot > div:first-child { grid-column:1 / -1; }
    .dst-{{ section.id }} .feat { flex-direction:row; }
    .dst-{{ section.id }} .feat div { flex-direction:column; align-items:center; text-align:center; gap:6px; font-size:11.5px; padding:12px 8px; }
    .dst-{{ section.id }} .feat div + div { border-left:1px solid var(--line); border-top:0; }
  }
  @media (max-width: 430px) {
    .dst-{{ section.id }} .cc { flex:0 0 90%; }
    .dst-{{ section.id }} .avatars i { width:30px; height:30px; }
  }

  /* sticky buy bar on mobile — keeps the offer reachable the whole way down */
  .dst-{{ section.id }} .sticky { display:none; }
  {%- if section.settings.sticky_cta -%}
  @media (max-width: 760px) {
    .dst-{{ section.id }} .sticky {
