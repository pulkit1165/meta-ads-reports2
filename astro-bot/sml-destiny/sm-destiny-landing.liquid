  {%- endif -%}
  {%- endif -%}
  /* "Same as desktop" mode: render the desktop composition at a fixed width
     and scale it to fit, so mobile is an exact miniature rather than a reflow. */
  .dst-fit-{{ section.id }} { overflow:hidden; width:100%; }
  .dst-stage-{{ section.id }} { transform-origin: top left; }
