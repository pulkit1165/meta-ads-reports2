<script>
(function(){
  var root=document.querySelector('.dst-{{ section.id }}');
  var MODE='{{ section.settings.mobile_mode }}';
  var DESIGN={{ section.settings.design_width }};
  var BP={{ section.settings.scale_below }};
  var fit=root?root.querySelector('[data-dst-fit]'):null;
  var stage=root?root.querySelector('[data-dst-stage]'):null;
  function fitStage(){
    if(!fit||!stage) return;
    var avail=fit.clientWidth;
    if(MODE!=='same'||avail>=BP){
      stage.style.width=''; stage.style.transform=''; fit.style.height='';
      return;
    }
    stage.style.width=DESIGN+'px';
    var k=avail/DESIGN;
    stage.style.transform='scale('+k+')';
    fit.style.height=Math.ceil(stage.getBoundingClientRect().height)+'px';
  }
  fitStage();
  window.addEventListener('resize',fitStage);
  window.addEventListener('load',fitStage);
  if(window.ResizeObserver&&stage){ new ResizeObserver(function(){ fitStage(); }).observe(stage); }
  setTimeout(fitStage,600); setTimeout(fitStage,1800);
  // Buy buttons call shiprocketCheckoutEvents.buyProduct(event) directly (see the
  // .shiprocket-headless / .sr-headless-checkout markup below) — verified against a real,
  // working "BUY NOW" button elsewhere on this store. That global function is Fastrr's own
  // checkout trigger; it reads the current product/variant from Shopify's standard page
  // context itself, no id/quantity needs to be passed in. The earlier fetch()+redirect and
  // form-submit attempts both bypassed Fastrr entirely, landing on native Shopify checkout —
  // that was the "buy now not working" bug, twice over.
})();
</script>

