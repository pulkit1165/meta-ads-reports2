# ── WhatsApp (Meta Cloud API) ────────────────────────────────────────────
WA_PHONE_NUMBER_ID=781898185017019      # Studd Muffyn production number
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=ntn_astro_change_me
WA_GRAPH_VERSION=v21.0

# ── LLM backend ──────────────────────────────────────────────────────────
ASTRO_LLM_BACKEND=claude_cli            # claude_cli (Mac, no API spend) | api (production)
CLAUDE_BIN=claude
# ANTHROPIC_API_KEY=                    # required when ASTRO_LLM_BACKEND=api
ASTRO_MODEL=claude-opus-5
ASTRO_EFFORT=medium
ASTRO_BRAND=Studd Muffyn Astro

# ── Chart engine ─────────────────────────────────────────────────────────
ASTRO_API_BASE=https://crystal-finder-seven.vercel.app

# ── Shopify (order verification, read-only) ──────────────────────────────
EXTRA_ENV_FILE=~/.openclaw/workspace/.env
# SHOPIFY_STORE_URL / SHOPIFY_ACCESS_TOKEN come from EXTRA_ENV_FILE

# ── Server ───────────────────────────────────────────────────────────────
PORT=8090
LOG_FILE=astro-bot.log
ASTRO_DB=astro.db
